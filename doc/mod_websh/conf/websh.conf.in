# Sample websh.conf file for mod_websh
#
# Generated by configure from websh.conf.in. Edit the installed copy, not
# this file; a fresh delivery is always installed next to it as
# websh.conf.dist.

# Character encoding of this Apache process.
#
# `encoding system' is process-global in Tcl (Tcl_SetSystemEncoding), not
# per interpreter: websh.conf runs in its own management interpreter, so
# variables set here are invisible to the request interpreters -- but the
# encoding reaches every .ws3.
#
# Without this line the encoding comes from the locale of the Apache
# process (on Debian from /etc/apache2/envvars, a conffile a package update
# or a colleague may change). Identical code then works on one host and
# mangles umlauts on the next: with iso8859-1 in effect a .ws3 reads its own
# UTF-8 source byte by byte, so the seven character literal "Anwaelte"
# (spelled with an umlaut) has length 8 instead of 7. On Linux that is what
# LANG=C gives you; macOS reports utf-8 either way, which is precisely why
# the value must not be left to the host.
#
# It does not replace \uXXXX escapes in source code: those carry without
# any host configuration and travel with the repository. Use both, not one
# instead of the other.
#
# Chosen at configure time:
#   --with-system-encoding=NAME   (default utf-8)
#   --without-system-encoding     (leave the line out)
@SYSTEM_ENCODING_LINE@

# root of websh files
if {[info sharedlibextension] == ".dll"} {
    # Windows
    set webshroot "C:/Program Files/Apache Group/Websh"
} else {
    # Unix (.so, .dylib ...) -- filled in by configure
    set webshroot @WEBSHROOT@
}

# Setup interpreter classes for mod_websh
proc web::interpmap {file} {

    global webshroot

    # special html content (html that contains snipplets only)
    # same as below, but configured to use different markup syntax
    if {[string match */other.html $file]} {
	return "$webshroot/conf/otherhandler.ws3"
    }

    # default html content (html that contains snipplets only)
    # all requests for *.html files share interpreters
    if {[string match *.html $file]} {
	return "$webshroot/conf/htmlhandler.ws3"
    }

    # individual scripts (each with its own interpreters)
    if {[string match *.ws3 $file]} {
	return $file
    }

}

# html handler interpreters live forever ...
web::interpclasscfg "$webshroot/conf/htmlhandler.ws3" maxrequests 0
# myApp handler interpreters live for 5 requests only
web::interpclasscfg "$webshroot/htdocs/myApp.ws3" maxrequests 5
# default for other interpreter classes: lifetime is only 1 requests
