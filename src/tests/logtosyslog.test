# -----------------------------------------------------------------------------
# tcltest package
# -----------------------------------------------------------------------------

if {[lsearch [namespace children] ::tcltest] == -1} {
    package require tcltest
    namespace import ::tcltest::*
}

# -----------------------------------------------------------------------------
# scanFileForPattern -- return "Ok" if pattern found in one of the lines of
#   file, "Failed" else.
# -----------------------------------------------------------------------------
proc scanFileForPattern {fileName pattern} {

    if {[file exists $fileName]} {
	if {[catch {
	    exec grep -F -- $pattern $fileName
	} msg]} {
	    return 0
	} else {
	    return 1
	}
    }
    return 0
}

# -----------------------------------------------------------------------------
# try to log to syslog
# -----------------------------------------------------------------------------

test logToSyslog-1.1 {websh3_toSyslog: logdest add returns id} {unixOnly} {
    web::logdest delete
    set res [web::logdest add info2.-debug syslog 0]
} {logdest0}


global srclist
set srclist [list /var/adm/messages /var/log/messages /var/log/syslog /var/log/system.log]

proc sysLogIsReadable {} {
    global srclist
    foreach file $srclist {
	if {[file readable $file]} {
	    return 1
	}
    }
    return 0
}

testConstraint sysLogUnreadableOrNotFound [sysLogIsReadable]

# -----------------------------------------------------------------------------
# sysLogDelivers -- 1 if a message sent via syslog() shows up in one of the
#   readable files of srclist. On macOS syslog() feeds the unified log, not
#   /var/log/system.log, so the file checks below would be meaningless there.
# -----------------------------------------------------------------------------
proc sysLogDelivers {} {
    global srclist
    if {![sysLogIsReadable]} {
	return 0
    }
    set marker "websh-syslog-probe-[clock seconds]-[pid]"
    web::logdest delete
    web::loglevel delete
    web::loglevel add info.-debug
    web::logdest add info.-debug syslog 10
    web::log info.info $marker
    web::logdest delete
    web::loglevel delete
    after 1000
    foreach file $srclist {
	if {[scanFileForPattern $file $marker]} {
	    return 1
	}
    }
    return 0
}

testConstraint sysLogDelivers [sysLogDelivers]

test logToSyslog-1.2 {websh3_toSyslog: test log} {unixOnly sysLogDelivers} {
    set res "Failed"

    set curTim [clock seconds]

    web::logdest delete
    web::loglevel delete

    set format "Websh T E S T toSyslog \[$curTim\]\n"
    web::loglevel add info.-debug
    web::logdest add -format $format info.-debug syslog 10

    web::log info.info {toSyslog}

    ## give syslog a little time to feed the message to the file
    after 1000

    global srclist
    foreach tmp $srclist {
        if {[scanFileForPattern $tmp [string trim $format]]} {
	    set res "Ok"
            break
        }
    }

    ## clean up
    web::logdest delete
    web::loglevel delete

    set res
} {Ok}

# -----------------------------------------------------------------------------
# a message with printf conversions must reach the destination verbatim
# (no log handler may use the message as a format string)
# -----------------------------------------------------------------------------
test logToSyslog-1.3 {message with printf conversions is written verbatim} {unixOnly sysLogDelivers} {
    set res "Failed"
    set probe "fmt-probe-[clock seconds]-[pid] A|%8s|B|%5d|C|%%|D"

    web::logdest delete
    web::loglevel delete
    web::loglevel add info.-debug
    web::logdest add info.-debug syslog 10

    web::log info.info $probe

    ## give syslog a little time to feed the message to the file
    after 1000

    global srclist
    foreach tmp $srclist {
        if {[scanFileForPattern $tmp $probe]} {
	    set res "Ok"
            break
        }
    }

    web::logdest delete
    web::loglevel delete

    set res
} {Ok}

# cleanup
::tcltest::cleanupTests
